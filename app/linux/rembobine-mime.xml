    <glob pattern="*.rvz"/>
    <glob pattern="*.cso"/>
    <glob pattern="*.gcz"/>
    <glob pattern="*.ciso"/>
    <glob pattern="*.gcm"/>
    <glob pattern="*.xiso"/>
    <glob pattern="*.xex"/>
    <glob pattern="*.vboy"/>
    <glob pattern="*.v64"/>
    <glob pattern="*.smd"/>
    <glob pattern="*.32x"/>
    <glob pattern="*.a78"/>
    <glob pattern="*.d64"/>
    <glob pattern="*.t64"/>
    <glob pattern="*.tzx"/>
    <glob pattern="*.z80"/>
    <glob pattern="*.cdt"/>
  </mime-type>
</mime-info>
