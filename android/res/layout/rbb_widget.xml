<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Rembobine : ce qui passe sur la TV, pause/lecture, volume − et + (voir Maison.java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="#E6141519">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/rbb_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rembobine"
            android:textColor="#FFF4EFE6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rbb_w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3F4EFE6"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <Button
        android:id="@+id/rbb_w_voldown"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="−"
        android:textSize="20sp"
        android:contentDescription="Volume moins" />

    <Button
        android:id="@+id/rbb_w_play"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:text="▶"
        android:textSize="18sp"
        android:contentDescription="Lecture ou pause" />

    <Button
        android:id="@+id/rbb_w_volup"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="+"
        android:textSize="20sp"
        android:contentDescription="Volume plus" />
</LinearLayout>
